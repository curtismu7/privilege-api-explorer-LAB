# Optional. The one shared settings file for every standalone app is ~/Development/.env (mode 600); STANDALONE_ENV=/path overrides the path.
# This app reads it with util.parseEnv and takes ONLY the keys below; every other key in the file is ignored. Never put an API secret in it.
# A bare MODE is never read. This file (.env.example) is a template only; nothing loads a .env from the repo.

# Real is refused unless this is real (the owner's opt-in). mock is the default. The page opens in Mock either way.
# PRIVILEGE_EXPLORER_MODE=mock
#
# Real connection, one-click preset (compose passes these through; the shared settings file also carries them on a host run).
# PRIV_EXPLORER_API_KEY=      the user API key from the Privilege console (Settings -> For Developers)
# PRIV_EXPLORER_API_SECRET=   the secret (write-only inside the app; never returned or logged)
# PRIV_LOG_CONSOLE_URL=       the console origin, e.g. https://local.procyon.ai:8643
# PRIV_LOG_CONSOLE_TENANT=    the tenant UUID
# PRIV_LOG_CONSOLE_CA=        (optional) only if the console needs a custom CA; the local desktop console needs none (self-signed is an option on the connection)

# Environment variables (not settings-file keys):
#   PORT=7813                  server port
#   PAE_DATA_DIR=.data         where connections (mode 600) and the audit log live
#   PAE_BIND=                  opt in to listen on a non-loopback address (the container sets 0.0.0.0 and is published on 127.0.0.1 only)
#   PAE_CONTAINER=1            set by the image only: lets Real accept the container's wide bind (a host run with PAE_BIND and Real is refused)
#   PAE_ALLOWED_HOSTS=         extra Host header names to accept
